 RowBox[{
  RowBox[{
   RowBox[{"p", "=", 
    RowBox[{"CharacteristicPolynomial", "[", 
     RowBox[{"H", ",", "\[Lambda]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
  "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Top", " ", "band", " ", "has", " ", "0", " ", "offset", " ", "at", " ", 
     "V"}], "=", "0"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Lambda]series1", "=", 
   RowBox[{
    RowBox[{"c1", " ", "V"}], "+", 
    RowBox[{"c2", " ", 
     RowBox[{"V", "^", "2"}]}], "+", 
    RowBox[{"c3", " ", 

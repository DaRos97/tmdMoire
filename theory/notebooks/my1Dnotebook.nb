    RowBox[{"coefficients1", ",", 
     RowBox[{"{", 
      RowBox[{"c1", ",", "c2", ",", "c3", ",", "c4", ",", "c5"}], "}"}]}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Lambda]Branches1", "=", 
   RowBox[{"\[Lambda]series1", "/.", "sols1"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Lower", " ", "bands", " ", "have"}], " ", "-", 
     RowBox[{"B", " ", "offset", " ", "at", " ", "V"}]}], "=", "0"}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Lambda]series2", "=", 
   RowBox[{
    RowBox[{"-", "B"}], "+", 
    RowBox[{"d1", " ", "V"}], "+", 
    RowBox[{"d2", " ", 
     RowBox[{"V", "^", "2"}]}], "+", 
    RowBox[{"d3", " ", 
     RowBox[{"V", "^", "3"}]}], "+", 
    RowBox[{"d4", " ", 
     RowBox[{"V", "^", "4"}]}], "+", 
    RowBox[{"d5", " ", 
     RowBox[{"V", "^", "5"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eq2", "=", 

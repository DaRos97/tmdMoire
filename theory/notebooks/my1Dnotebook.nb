d031818196eb"],

Cell["\<\
In order to know to which branch to compute the distance we need to know \
where the weight is going\
\>", "Text",
 CellChangeTimes->{{3.997849045165317*^9, 
  3.997849072898884*^9}},ExpressionUUID->"419378f8-3a02-45fc-8006-\
4254fb7c2c80"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"B", ",", "V"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"H", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "B"}], ",", "V", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"V", ",", "0", ",", "V"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "V", ",", 
       RowBox[{"-", "B"}]}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"evals", ",", " ", "evecs"}], "}"}], "=", 
   RowBox[{"Eigensystem", "[", "H", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"vecsN", "=", 
   RowBox[{"Map", "[", 
    RowBox[{"Normalize", ",", "evecs"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"order", "=", 
   RowBox[{"Ordering", "[", "evals", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{

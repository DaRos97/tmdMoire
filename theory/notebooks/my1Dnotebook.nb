      RowBox[{"Assumptions", "->", 
       RowBox[{"B", ">", "0"}]}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "3"}], "}"}]}], "]"}]}]}], "Input",

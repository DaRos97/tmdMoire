Cell[CellGroupData[{

Cell["Analytic derivation of the gap", "Subtitle",
 CellChangeTimes->{{3.997838283237213*^9, 
  3.997838295273616*^9}},ExpressionUUID->"33f83c40-c822-46fc-bc96-\
915179d73c20"],

Cell["\<\
We expand the first two eigenvalues in a series expansion and then subtract \
them to get the gap.
A=hbar^2 G^2 / 8m\
\>", "Text",
 CellChangeTimes->{{3.997840251112565*^9, 
  3.997840342068062*^9}},ExpressionUUID->"2a68f73c-9c45-4c73-a446-\
4dc7a82ee043"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{
    "A", ",", "V", ",", "\[Lambda]", ",", "c1", ",", "c2", ",", "c3", ",", 
     "c4", ",", "c5"}], "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"H", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "A"}], ",", "V", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"V", ",", 
       RowBox[{"-", "A"}], ",", "V"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "V", ",", 
       RowBox[{
        RowBox[{"-", "9"}], " ", "A"}]}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"p", "=", 
    RowBox[{"CharacteristicPolynomial", "[", 
     RowBox[{"H", ",", "\[Lambda]"}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Lambda]series", "=", 
    RowBox[{
     RowBox[{"-", "A"}], "+", 
     RowBox[{"c1", " ", "V"}], "+", 
     RowBox[{"c2", " ", 
      RowBox[{"V", "^", "2"}]}], "+", 
     RowBox[{"c3", " ", 
      RowBox[{"V", "^", "3"}]}], "+", 
     RowBox[{"c4", " ", 
      RowBox[{"V", "^", "4"}]}], "+", 
     RowBox[{"c5", " ", 
      RowBox[{"V", "^", "5"}]}]}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"eq", "=", 
    RowBox[{
     RowBox[{"Normal", "@", 
      RowBox[{"Series", "[", 
       RowBox[{
        RowBox[{"p", "/.", " ", 
         RowBox[{"\[Lambda]", "->", "\[Lambda]series"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"V", ",", "0", ",", "6"}], "}"}]}], "]"}]}], "//", 
     "Expand"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"coefficients", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Coefficient", "[", 
        RowBox[{"eq", ",", "V", ",", "n"}], "]"}], "==", "0"}], ",", 
      RowBox[{"{", 
       RowBox[{"n", ",", "1", ",", "6"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"sols", "=", 
   RowBox[{"Solve", "[", 
    RowBox[{"coefficients", ",", 
     RowBox[{"{", 
      RowBox[{"c1", ",", "c2", ",", "c3", ",", "c4", ",", "c5"}], "}"}]}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Lambda]Branches", "=", 
   RowBox[{"\[Lambda]series", "/.", "sols"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"gap", "=", 
  RowBox[{"Expand", "[", 
   RowBox[{
    RowBox[{"\[Lambda]Branches", "[", 
     RowBox[{"[", "1", "]"}], "]"}], "-", 
    RowBox[{"\[Lambda]Branches", "[", 
     RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.997838550960676*^9, 3.997838603364952*^9}, {
  3.9978386360331287`*^9, 3.997838683575986*^9}, {3.997838739194244*^9, 
  3.997838789095545*^9}, {3.997839624635254*^9, 3.997839696311303*^9}, {
  3.997839978572761*^9, 3.997840222392714*^9}},
 CellLabel->"In[81]:=",ExpressionUUID->"f9487e14-06bc-4ae5-bd31-486827479402"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"-", "2"}], " ", "V"}], "+", 
  FractionBox[
   RowBox[{"3", " ", 
    SuperscriptBox["V", "3"]}], 
   RowBox[{"256", " ", 
    SuperscriptBox["A", "2"]}]], "-", 
  FractionBox[
   RowBox[{"55", " ", 
    SuperscriptBox["V", "5"]}], 
   RowBox[{"262144", " ", 
    SuperscriptBox["A", "4"]}]]}]], "Output",
 CellChangeTimes->{{3.997838591498558*^9, 3.9978386043830023`*^9}, 

    RowBox[{
    "A", ",", "V", ",", "\[Lambda]", ",", "c1", ",", "c2", ",", "c3", ",", 
     "c4", ",", "c5", ",", "d1", ",", "d2", ",", "d3", ",", "d4", ",", "d5"}],
     "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{

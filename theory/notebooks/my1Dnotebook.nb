Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"Physical", " ", "constants"}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"hbar", " ", "=", " ", 
    RowBox[{"6.582119569", "*", 
     RowBox[{"10", "^", 
      RowBox[{"-", "13"}]}]}]}], ";"}], "  ", 
  RowBox[{"(*", " ", 
   RowBox[{"meV", " ", "s"}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"m0", " ", "=", " ", 
    RowBox[{"9.1093837", "*", 
     RowBox[{"10", "^", 
      RowBox[{"-", "31"}]}]}]}], ";"}], "      ", 
  RowBox[{"(*", " ", "kg", " ", "*)"}], "\n", 
  RowBox[{"(*", " ", "Parameters", " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"G", " ", "=", " ", "0.1257"}], ";"}], "                 ", 
  RowBox[{"(*", " ", 
   RowBox[{"A", "^", 
    RowBox[{"-", "1"}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"m", " ", "=", " ", 
    RowBox[{"3.5", " ", "m0"}]}], ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"Convert", " ", 
    RowBox[{
     RowBox[{"hbar", "^", "2"}], "/", 
     RowBox[{"(", 
      RowBox[{"2", "m"}], ")"}]}], " ", "to", " ", "meV", " ", 
    RowBox[{"A", "^", "2"}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"hbarSI", " ", "=", " ", 
    RowBox[{"1.054571817", "*", 
     RowBox[{"10", "^", 
      RowBox[{"-", "34"}]}]}]}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"J", " ", "s"}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"eV", " ", "=", " ", 
    RowBox[{"1.602176634", "*", 
     RowBox[{"10", "^", 
      RowBox[{"-", "19"}]}]}]}], ";"}], "      ", 
  RowBox[{"(*", " ", "J", " ", "*)"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"alpha", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"hbarSI", "^", "2"}], "/", 
      RowBox[{"(", 
       RowBox[{"2", " ", "m"}], ")"}]}], " ", "/", " ", 
     RowBox[{"(", 
      RowBox[{"eV", "*", 
       RowBox[{"10", "^", 
        RowBox[{"-", "3"}]}]}], ")"}]}], " ", "*", " ", 
    RowBox[{"10", "^", "20"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"eps", "[", 
    RowBox[{"k_", ",", "n_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"-", "alpha"}], " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"k", "+", 
       RowBox[{"n", " ", "G"}]}], ")"}], "^", "2"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"H", "[", 
    RowBox[{"k_", ",", "v_"}], "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"eps", "[", 
        RowBox[{"k", ",", 
         RowBox[{"-", "1"}]}], "]"}], ",", "v", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"v", ",", 
       RowBox[{"eps", "[", 
        RowBox[{"k", ",", "0"}], "]"}], ",", "v"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "v", ",", 
       RowBox[{"eps", "[", 
        RowBox[{"k", ",", "1"}], "]"}]}], "}"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{"Manipulate", "[", "\n", "\t", 
  RowBox[{
   RowBox[{"Plot", "[", "\n", "\t  ", 
    RowBox[{
     RowBox[{"Evaluate", "[", 
      RowBox[{"Eigenvalues", "[", 
       RowBox[{"H", "[", 
        RowBox[{"k", ",", "v"}], "]"}], "]"}], "]"}], ",", "\n", "\t  ", 
     RowBox[{"{", 
      RowBox[{"k", ",", " ", 
       RowBox[{
        RowBox[{"-", "3"}], " ", "G"}], ",", " ", 
       RowBox[{"3", " ", "G"}]}], "}"}], ",", "\n", "\t  ", 
     RowBox[{"PlotRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"5", ",", 
        RowBox[{"-", "100"}]}], "}"}]}], ",", "\n", "\t  ", 
     RowBox[{"AxesLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<k (A^-1)\>\"", ",", " ", "\"\<Energy (meV)\>\""}], 

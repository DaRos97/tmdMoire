     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "B"}], ",", "V", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"V", ",", "0", ",", "V"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "V", ",", 

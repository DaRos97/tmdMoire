   RowBox[{"{", 
    RowBox[{"v", ",", " ", "0", ",", " ", "3"}], "}"}]}], "\n", 
  "]"}]}], "Input",
 CellChangeTimes->{{3.9977567997246857`*^9, 3.997756825232189*^9}, {
  3.997756899116157*^9, 3.9977569139640093`*^9}, {3.9977573895527067`*^9, 
  3.997757434463024*^9}, {3.997757773536133*^9, 3.997757787736102*^9}, {

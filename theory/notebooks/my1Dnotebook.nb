Cell[CellGroupData[{

Cell["Weight ratio at same k=-1.5G", "Subtitle",
 CellChangeTimes->{{3.997851012203108*^9, 
  3.9978510341833344`*^9}},ExpressionUUID->"e016136d-c0ca-4171-9a4d-\
5bef0a19bb71"],

Cell["\<\
We follow the same procedure as the section above, but we need to be careful \
to select the right band.
Since there is no closed form for the eigenvalue solution in this case we use \
Rayleigh-Schroedinger perturbation theory.\
\>", "Text",
 CellChangeTimes->{{3.9978512992062693`*^9, 3.9978513318559923`*^9}, 
   3.997851547916415*^9, {3.997852914219323*^9, 
   3.997852959189042*^9}},ExpressionUUID->"0bb88278-03b4-45a3-9b3a-\
676a5ced14dd"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"H", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "A"}], ",", "V", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"V", ",", 
       RowBox[{
        RowBox[{"-", "9"}], "A"}], ",", "V"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "V", ",", 
       RowBox[{
        RowBox[{"-", "25"}], " ", "A"}]}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"H0", "=", 
   RowBox[{"DiagonalMatrix", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "A"}], ",", 
      RowBox[{
       RowBox[{"-", "9"}], "A"}], ",", 
      RowBox[{
       RowBox[{"-", "25"}], "A"}]}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"M", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "1", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "0", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "1", ",", "0"}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"c", "[", 
    RowBox[{"n_", ",", "m_"}], "]"}], ":=", 
   RowBox[{"V", " ", 
    RowBox[{
     RowBox[{"M", "[", 
      RowBox[{"[", 
       RowBox[{"n", ",", "m"}], "]"}], "]"}], "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"H0", "[", 
        RowBox[{"[", 
         RowBox[{"n", ",", "n"}], "]"}], "]"}], "-", 
       RowBox[{"H0", "[", 
        RowBox[{"[", 
         RowBox[{"m", ",", "m"}], "]"}], "]"}]}], ")"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"W", "[", 
   RowBox[{"n_", ",", "k_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"Piecewise", "[", 
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", "-", 
         RowBox[{
          RowBox[{"V", "^", "2"}], "*", 
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"m", "!=", "n"}], ",", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{
                RowBox[{"M", "[", 
                 RowBox[{"[", 
                  RowBox[{"n", ",", "m"}], "]"}], "]"}], "^", "2"}], "/", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"H0", "[", 
                   RowBox[{"[", 
                    RowBox[{"n", ",", "n"}], "]"}], "]"}], "-", 
                  RowBox[{"H0", "[", 
                   RowBox[{"[", 
                    RowBox[{"m", ",", "m"}], "]"}], "]"}]}], ")"}], "^", 
                "2"}]}], ",", "0"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"m", ",", "3"}], "}"}]}], "]"}]}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"k", "==", "n"}]}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"V", "^", "2"}], "*", 
         RowBox[{
          RowBox[{
           RowBox[{"M", "[", 
            RowBox[{"[", 
             RowBox[{"n", ",", "k"}], "]"}], "]"}], "^", "2"}], "/", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"H0", "[", 
              RowBox[{"[", 
               RowBox[{"n", ",", "n"}], "]"}], "]"}], "-", 
             RowBox[{"H0", "[", 
              RowBox[{"[", 
               RowBox[{"k", ",", "k"}], "]"}], "]"}]}], ")"}], "^", "2"}]}]}],
         ",", 
        RowBox[{"k", "!=", "n"}]}], "}"}]}], "\[IndentingNewLine]", "}"}], 
    "]"}], "+", 
   RowBox[{
    RowBox[{"O", "[", "V", "]"}], "^", "7"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"Expand", "[", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{"W", "[", 
     RowBox[{"1", ",", "2"}], "]"}], "/", 
    RowBox[{"W", "[", 
     RowBox[{"2", ",", "2"}], "]"}]}], "]"}], "]"}]}], "Input",
 CellChangeTimes->{{3.997851275047213*^9, 3.99785128743703*^9}, {
   3.997851342957099*^9, 3.997851359634535*^9}, {3.997851434693163*^9, 
